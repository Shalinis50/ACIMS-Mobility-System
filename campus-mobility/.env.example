# REC Campus Mobility — Configuration & API Keys (Optional)
#
# NOTE: The system works 100% out of the box with NO API KEYS REQUIRED!
# - Walking routing uses OpenStreetMap Foot OSRM Engine and the verified REC in-campus graph.
# - Map tiles use OpenStreetMap HOT and Esri World Street/Satellite (zero watermarks, free).
#
# If you have an official Carto, Mapbox, or Google Maps key, you can configure it here
# or paste it directly in the app via the in-app Data/Settings modal:

# CARTO API Key (Removes watermarks if using Carto Voyager tiles)
CARTO_API_KEY=

# Mapbox Access Token (Optional)
MAPBOX_ACCESS_TOKEN=

# Google Maps API Key (Optional)
GOOGLE_MAPS_API_KEY=
