# ==============================================================================
# ACMIS Environment Configuration Template
# Copy this file to .env and configure values for your local development.
# NOTE: Never commit your actual .env file to Git.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=acmis_db
DB_USER=acmis_user
DB_PASSWORD=your_database_password_here

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=24h

# Service & Mapping Integrations
MAP_SERVICE_API_KEY=your_map_api_key_here

# Client CORS Origin
CLIENT_ORIGIN=http://localhost:3000
