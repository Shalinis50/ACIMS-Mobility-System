{
  "name": "acims-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "node server.ts",
    "transit:sync": "tsx scripts/sync-transit.ts",
    "mobility:seed": "tsx scripts/seed-mobility-core.ts",
    "dev:reset": "rm -rf data/postgres && npm run dev",
    "mtc:sync": "tsx scripts/mtc-sync.ts",
    "rec:sync": "tsx scripts/rec-sync.ts",
    "rec:publish": "tsx scripts/rec-sync.ts --publish-only",
    "build": "vite build --config artifacts/acims/vite.config.ts && esbuild server-app.ts --bundle --platform=node --format=esm --packages=external --outfile=server.bundle.js",
    "gcp-build": "npm run build",
    "lint": "tsc --noEmit",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.27.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "express": "^5.0.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "tsx": "^4.19.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  }
}
